{
  "_version": "1.37.0",
  "sap.app": {
    "id": "retail.analytics.salesoverview",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap-ux/fiori-elements-writer:ovp",
      "version": "3.0.16"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/analytics/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.96.8",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.ovp": {},
        "sap.ui.rta": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "retail.analytics.salesoverview.i18n.i18n"
        }
      },
      "mainModel": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [],
      "targets": {}
    }
  },
  "sap.ovp": {
    "globalFilterModel": "mainModel",
    "globalFilterEntitySet": "SalesFacts",
    "containerLayout": "resizable",
    "enableLiveFilter": true,
    "considerAnalyticalParameters": false,
    "cards": {
      "cardRevenueKpi": {
        "model": "mainModel",
        "template": "sap.ovp.cards.charts.analytical",
        "settings": {
          "title": "Total Revenue",
          "subTitle": "Monthly trend (USD)",
          "entitySet": "SalesFacts",
          "dataPointAnnotationPath": "com.sap.vocabularies.UI.v1.DataPoint#revenue",
          "chartAnnotationPath": "com.sap.vocabularies.UI.v1.Chart#byMonth",
          "presentationAnnotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant#byMonth"
        }
      },
      "cardProfitKpi": {
        "model": "mainModel",
        "template": "sap.ovp.cards.charts.analytical",
        "settings": {
          "title": "Total Profit",
          "subTitle": "By category (USD)",
          "entitySet": "SalesFacts",
          "dataPointAnnotationPath": "com.sap.vocabularies.UI.v1.DataPoint#profit",
          "chartAnnotationPath": "com.sap.vocabularies.UI.v1.Chart#byCategory",
          "presentationAnnotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant#byCategory"
        }
      },
      "cardMarginKpi": {
        "model": "mainModel",
        "template": "sap.ovp.cards.list",
        "settings": {
          "title": "Profit Margin",
          "subTitle": "Overall (revenue, profit, margin %)",
          "entitySet": "OverallPerformance",
          "listType": "condensed",
          "listFlavor": "standard",
          "dataPointAnnotationPath": "com.sap.vocabularies.UI.v1.DataPoint#margin",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem"
        }
      },
      "cardRevenueByCountry": {
        "model": "mainModel",
        "template": "sap.ovp.cards.charts.analytical",
        "settings": {
          "title": "Revenue by Country",
          "entitySet": "SalesFacts",
          "dataPointAnnotationPath": "com.sap.vocabularies.UI.v1.DataPoint#revenue",
          "chartAnnotationPath": "com.sap.vocabularies.UI.v1.Chart#byCountry",
          "presentationAnnotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant#byCountry"
        }
      },
      "cardStorePerformance": {
        "model": "mainModel",
        "template": "sap.ovp.cards.charts.analytical",
        "settings": {
          "title": "Store Performance",
          "subTitle": "Revenue by store country (USD)",
          "entitySet": "SalesFacts",
          "dataPointAnnotationPath": "com.sap.vocabularies.UI.v1.DataPoint#revenue",
          "chartAnnotationPath": "com.sap.vocabularies.UI.v1.Chart#byStore",
          "presentationAnnotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant#byStore"
        }
      },
      "cardChannelSplit": {
        "model": "mainModel",
        "template": "sap.ovp.cards.charts.analytical",
        "settings": {
          "title": "Online vs Physical Sales",
          "subTitle": "Revenue by sales channel (USD)",
          "entitySet": "SalesFacts",
          "dataPointAnnotationPath": "com.sap.vocabularies.UI.v1.DataPoint#revenue",
          "chartAnnotationPath": "com.sap.vocabularies.UI.v1.Chart#byChannel",
          "presentationAnnotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant#byChannel"
        }
      },
      "cardDailyTrend": {
        "model": "mainModel",
        "template": "sap.ovp.cards.charts.analytical",
        "settings": {
          "title": "Daily Revenue Trend",
          "subTitle": "Revenue by order date — last 90 days (USD)",
          "entitySet": "SalesFacts",
          "dataPointAnnotationPath": "com.sap.vocabularies.UI.v1.DataPoint#revenue",
          "chartAnnotationPath": "com.sap.vocabularies.UI.v1.Chart#byDate",
          "presentationAnnotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant#byDate",
          "selectionAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#last90Days"
        }
      }
    },
    "globalFilterControlType": "MacroFilterBar"
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "analytical"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
