{
  "_version": "1.33.0",
  "sap.app": {
    "id": "retail.analytics.salesassociation",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap-ux/fiori-elements-writer:lrop",
      "version": "3.0.16"
    },
    "dataSources": {
      "mainService": {
        "uri": "/association/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://scatter-chart"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.90.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "retail.analytics.salesassociation.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "AssociationList",
          "target": "AssociationList"
        }
      ],
      "targets": {
        "AssociationList": {
          "type": "Component",
          "id": "AssociationList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "DemographicAffinity",
              "variantManagement": "None",
              "initialLoad": "Enabled",
              "views": {
                "paths": [
                  {
                    "key": "demographic",
                    "entitySet": "DemographicAffinity",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Main"
                  },
                  {
                    "key": "elasticity",
                    "entitySet": "PriceElasticity",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Main"
                  },
                  {
                    "key": "storesize",
                    "entitySet": "StoreSizeRevenue",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Main"
                  },
                  {
                    "key": "correlation",
                    "entitySet": "StoreSizeCorrelation",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Main"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "analytical"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": false
    }
  }
}
